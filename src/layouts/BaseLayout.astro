---
import '../styles/global.css';
import ArtDots from '../components/layout/ArtDots.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import type { SEOProps } from '../types/seo';
import { buildPageMeta, personSchema, websiteSchema } from '../lib/seo';

interface Props extends SEOProps {
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
const meta = buildPageMeta(props);
const schemas = [
  personSchema(),
  websiteSchema(),
  ...(props.schema ? (Array.isArray(props.schema) ? props.schema : [props.schema]) : []),
];
const ogLocaleAlternates = meta.alternates
  .filter((item) => item.hreflang !== 'x-default' && item.href !== meta.canonical)
  .map((item) => item.hreflang.replace('-', '_'));
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content={meta.robots} />
    <meta name="keywords" content={meta.keywords.join(', ')} />
    <meta name="theme-color" content="#6366f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={meta.canonical} />
    {meta.alternates.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Notlar RSS`} href={`${site.url}/rss.xml`} />
    <link rel="manifest" href={`${site.url}/manifest.webmanifest`} />
    {
      meta.preloadImage && (
        <link rel="preload" as="image" href={meta.preloadImage} fetchpriority="high" />
      )
    }
    <meta property="og:title" content={meta.openGraph.title} />
    <meta property="og:description" content={meta.openGraph.description} />
    <meta property="og:url" content={meta.openGraph.url} />
    <meta property="og:type" content={meta.openGraph.type} />
    <meta property="og:site_name" content={meta.openGraph.siteName} />
    <meta property="og:locale" content={meta.openGraph.locale} />
    {ogLocaleAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:image" content={meta.openGraph.image} />
    <meta property="og:image:alt" content={meta.openGraph.imageAlt} />
    <meta property="og:image:width" content={String(meta.openGraph.imageWidth)} />
    <meta property="og:image:height" content={String(meta.openGraph.imageHeight)} />
    {
      meta.article && (
        <>
          <meta property="article:published_time" content={meta.article.publishedTime} />
          <meta property="article:modified_time" content={meta.article.modifiedTime} />
          <meta property="article:author" content={site.author} />
        </>
      )
    }
    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />
    <meta name="twitter:creator" content={meta.twitter.creator} />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a href="#main-content" class="skip-link">İçeriğe atla</a>
    <ArtDots />
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header />
      <main id="main-content" class="relative z-10 flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
