---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<div class="mt-16 sm:mt-32">
  <header class="max-w-2xl">
    <h1 class="text-4xl font-bold tracking-tight text-balance text-zinc-800 dark:text-zinc-100 sm:text-5xl">
      {title}
    </h1>
    {intro && <p class="mt-6 text-base text-balance">{intro}</p>}
  </header>
  <div class="mt-16 sm:mt-20">
    <slot />
  </div>
</div>
