---
import { navigation, site } from '../../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<footer class="mt-32 flex-none">
  <div class="sm:px-8">
    <div class="mx-auto w-full max-w-7xl lg:px-8">
      <div class="relative border-t border-zinc-100 pt-10 pb-16 dark:border-zinc-700/40">
        <div class="relative px-4 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <div class="flex flex-col items-center justify-between gap-6 sm:flex-row sm:flex-wrap">
              <nav
                class="flex flex-wrap justify-center gap-6 text-sm font-medium text-zinc-800 dark:text-zinc-200"
                aria-label="Alt menü">
                {
                  navigation.map((item) => (
                    <a
                      href={item.href}
                      class:list={[
                        'transition hover:text-primary',
                        currentPath === item.href && 'text-primary',
                      ]}
                      aria-current={currentPath === item.href ? 'page' : undefined}>
                      {item.name}
                    </a>
                  ))
                }
              </nav>
              <p class="text-center text-sm text-zinc-400 sm:text-left dark:text-zinc-500">
                <a
                  href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-zinc-600 dark:hover:text-zinc-300">
                  CC BY-NC-SA 4.0
                </a>
                {' '}
                2026–Günümüz © {site.name}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
