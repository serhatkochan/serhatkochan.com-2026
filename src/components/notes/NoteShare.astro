---
import { buildTwitterShareUrl } from '../../lib/share';

interface Props {
  url: string;
}

const { url } = Astro.props;
const twitterShareUrl = buildTwitterShareUrl(url);
---

<a
  href={twitterShareUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex max-w-lg items-start gap-3 text-sm text-zinc-600 transition hover:text-primary dark:text-zinc-400 dark:hover:text-primary-light">
  <svg
    class="mt-0.5 h-5 w-5 shrink-0 transition group-hover:-rotate-12"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true">
    <path
      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
    ></path>
  </svg>
  <span>Bu notu beğendiyseniz X'te arkadaşlarınızla paylaşmak için buraya tıklayın.</span>
</a>
