---
import { ANIMSAT_NAME, getLanding, landingPath, policyPath, type AnimsatLocale } from '../../data/animsat';

interface Props {
  locale?: AnimsatLocale;
}

const { locale = 'tr' } = Astro.props;
const copy = getLanding(locale);
---

<footer class="border-t border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 sm:flex-row sm:items-end sm:justify-between sm:px-8">
    <a href={landingPath(locale)} class="text-[#faf8f5]">
      <p class="animsat-display text-xl">{ANIMSAT_NAME}</p>
      <p class="mt-1 text-sm text-[#a8a29e]">{copy.tagline}</p>
    </a>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[#faf8f5]/55">
      <a href={policyPath(locale)} class="hover:text-[#faf8f5]">{copy.footerPrivacy}</a>
      <a href="https://www.serhatkochan.com" class="hover:text-[#faf8f5]">{copy.footerNote}</a>
    </div>
  </div>
</footer>
