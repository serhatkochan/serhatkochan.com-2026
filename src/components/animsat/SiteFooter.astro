---
import { Image } from 'astro:assets';
import { ANIMSAT_NAME, ANIMSAT_GITHUB_URL, getLanding, landingPath, policyPath, supportPath, type AnimsatLocale } from '../../data/animsat';
import logo from '../../assets/animsat/logo.png';

interface Props {
  locale?: AnimsatLocale;
}

const { locale = 'tr' } = Astro.props;
const copy = getLanding(locale);
const homeHref = landingPath(locale);
const navTitle = locale === 'tr' ? 'Gezinme' : 'Navigation';
const legalTitle = locale === 'tr' ? 'Yasal & Destek' : 'Legal & Support';
const allRights = locale === 'tr' ? 'Tüm hakları saklıdır.' : 'All rights reserved.';
const offlineBadge = locale === 'tr' ? '%100 Çevrimdışı ve Güvenli' : '100% Offline & Private';
---

<footer class="relative mt-24 border-t border-white/[0.08] bg-[#050507]">
  <!-- Subtle ambient top border glow -->
  <div class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-white/20 to-transparent" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <!-- Brand Column -->
      <div class="max-w-sm">
        <a href={homeHref} class="flex items-center gap-3 text-white transition-opacity hover:opacity-90">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 p-1 ring-1 ring-white/15">
            <Image src={logo} alt="" width={64} height={64} densities={[1, 2]} format="png" class="h-full w-full object-contain" />
          </div>
          <div>
            <span class="animsat-display text-xl font-semibold tracking-tight">{ANIMSAT_NAME}</span>
            <span class="block text-xs font-mono tracking-wider text-[#d96b52] uppercase">{copy.tagline}</span>
          </div>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-stone-400">
          {copy.seoDescription}
        </p>
      </div>

      <!-- Links & Navigation -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-2 sm:gap-12">
        <div>
          <p class="text-xs font-semibold tracking-widest text-stone-300 uppercase">{navTitle}</p>
          <ul class="mt-3 space-y-2 text-sm text-stone-400" role="list">
            <li><a href={`${homeHref}#ozellikler`} class="transition-colors hover:text-white">{copy.featuresKicker}</a></li>
            <li><a href={`${homeHref}#widgetlar`} class="transition-colors hover:text-white">Widget</a></li>
            <li><a href={`${homeHref}#ucretsiz`} class="transition-colors hover:text-white">{copy.proKicker}</a></li>
            <li>
              <a
                href={ANIMSAT_GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 transition-colors hover:text-white"
              >
                <span>GitHub</span>
                <span class="text-xs text-stone-500 font-mono">↗</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-widest text-stone-300 uppercase">{legalTitle}</p>
          <ul class="mt-3 space-y-2 text-sm text-stone-400" role="list">
            <li><a href={policyPath(locale)} class="transition-colors hover:text-white">{copy.footerPrivacy}</a></li>
            <li><a href={supportPath(locale)} class="transition-colors hover:text-white">{copy.footerSupport}</a></li>
            <li><a href="https://www.serhatkochan.com" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">{copy.footerNote}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/[0.06] pt-8 text-xs text-stone-500 sm:flex-row">
      <p>© {new Date().getFullYear()} {ANIMSAT_NAME}. {allRights}</p>
      <div class="flex items-center gap-4">
        <a
          href={ANIMSAT_GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-stone-400 transition-colors hover:text-white"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>{locale === 'tr' ? 'Açık Kaynak' : 'Open Source'}</span>
        </a>
        <span class="text-stone-700">·</span>
        <div class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
          <span>{offlineBadge}</span>
        </div>
      </div>
    </div>
  </div>
</footer>
