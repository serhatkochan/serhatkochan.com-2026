---
import AnimsatLayout from '../../layouts/AnimsatLayout.astro';
import PhoneFrame from './PhoneFrame.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import {
  ANIMSAT_NAME,
  ANIMSAT_PLAY_STORE_URL,
  ANIMSAT_GITHUB_URL,
  ANIMSAT_POLICY_LOCALES,
  ANIMSAT_SITE_URL,
  getAnimsatLocale,
  getAppStoreUrl,
  getLanding,
  landingCanonical,
  landingPath,
  policyPath,
  type AnimsatLocale,
} from '../../data/animsat';
import { softwareApplicationSchema } from '../../lib/seo';
import shotHome from '../../assets/animsat/onboarding-home.jpg';
import shotPhoto from '../../assets/animsat/onboarding-add-photo.jpg';
import shotColor from '../../assets/animsat/onboarding-add.jpg';
import shotWidget from '../../assets/animsat/onboarding-widget.jpg';

interface Props {
  locale: AnimsatLocale;
}

const { locale } = Astro.props;
const localeDef = getAnimsatLocale(locale);
const copy = getLanding(locale);
const privacyHref = policyPath(locale);
const homePath = landingPath(locale);
const homeCanonical = landingCanonical(locale);
const appStoreUrl = getAppStoreUrl(locale);
const marqueeCopies = [0, 1];

const featureDates = copy.features.find((item) => item.id === 'dates') ?? copy.features[0];
const featureWidget = copy.features.find((item) => item.id === 'widget') ?? copy.features[1];
const featurePhoto = copy.features.find((item) => item.id === 'photo') ?? copy.features[2];
const featureColor = copy.features.find((item) => item.id === 'color') ?? copy.features[3];

const alternates = [
  ...ANIMSAT_POLICY_LOCALES.map((item) => ({
    hreflang: item.hreflang,
    href: landingCanonical(item.id),
  })),
  { hreflang: 'x-default', href: landingCanonical('tr') },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: ANIMSAT_NAME,
    alternateName: copy.tagline,
    url: ANIMSAT_SITE_URL,
    description: copy.seoDescription,
    inLanguage: localeDef.htmlLang,
  },
  softwareApplicationSchema(),
];

// Multilingual micro-copy dictionary
const isTurkish = locale === 'tr';
const ui = {
  trustOffline: isTurkish ? '%100 Çevrimdışı' : '100% Offline',
  trustTrackers: isTurkish ? 'Sıfır İzleyici' : 'Zero Trackers',
  trustWidgets: isTurkish ? 'Widget Desteği' : 'Widget Support',
  floatingBirthday: isTurkish ? 'Doğum Günü' : 'Birthday',
  floatingBirthdaySub: isTurkish ? '308 gün kaldı' : '308 days left',
  floatingWidget: isTurkish ? 'Kilit Ekranı' : 'Lock Screen',
  floatingWidgetSub: isTurkish ? 'Canlı Widget' : 'Live Widget',
  floatingPrivacy: isTurkish ? 'Tamamen Gizli' : 'Private by Design',
  floatingPrivacySub: isTurkish ? '0 Veri Aktarımı' : '0 Data Sent',
  featuresSub: isTurkish
    ? 'Karmaşık takvimler veya dikkat dağıtan bildirimler yok. Sadece senin için değerli anlar, en saf ve zarif haliyle.'
    : 'No cluttered calendars or noisy notifications. Just the moments you hold dear, in their purest form.',
  feature1Pillar1Title: isTurkish ? 'Hassas Gün Sayımı' : 'Precise Countdown',
  feature1Pillar1Desc: isTurkish ? 'Hedefine kalan günleri anlık olarak hesaplar.' : 'Calculates the exact days remaining instantly.',
  feature1Pillar2Title: isTurkish ? 'Öncelikli Sabitleme' : 'Priority Pinning',
  feature1Pillar2Desc: isTurkish ? 'En heyecanla beklediğin tarihi en tepeye yerleştir.' : 'Keep your most awaited milestones right on top.',
  feature2Pillar1Title: isTurkish ? 'Kilit Ekranı' : 'Lock Screen',
  feature2Pillar1Desc: isTurkish ? 'Ekranı açmadan tek bakışta gör.' : 'Check days remaining without unlocking your device.',
  feature2Pillar2Title: isTurkish ? 'Farklı Boyutlar' : 'Multiple Sizes',
  feature2Pillar2Desc: isTurkish ? 'Küçük ve orta boy ana ekran kartları.' : 'Small and medium home screen widgets.',
  feature2Pillar3Title: isTurkish ? 'Sıfır Pil Yükü' : 'Zero Battery Impact',
  feature2Pillar3Desc: isTurkish ? 'Yerel ve ultra optimize sistem motoru.' : 'Native, ultra-lightweight system engine.',
  studioKicker: isTurkish ? '03 & 04 / KİŞİSELLEŞTİRME STÜDYOSU' : '03 & 04 / PERSONALIZATION STUDIO',
  studioTitle: isTurkish ? 'Senin anın, senin tarzın.' : 'Your moment, your style.',
  studioSub: isTurkish
    ? 'İster unutulmaz bir hatıra fotoğrafı, ister göz alıcı minimalist renk paletleri.'
    : 'Whether a cherished photo memory or a sleek minimalist gradient theme.',
  photoBadge: isTurkish ? 'Özelleştirilebilir' : 'Customizable',
  colorBadge: isTurkish ? 'Degrade & Minimal' : 'Gradient & Minimal',
  privacyPillar1Title: isTurkish ? 'Sıfır Sunucu' : 'Zero Server',
  privacyPillar1Desc: isTurkish ? 'Verileriniz hiçbir sunucuya iletilmez, yalnızca cihazınızda yaşar.' : 'Your data never leaves your device. No cloud storage.',
  privacyPillar2Title: isTurkish ? 'Sıfır İzleyici' : 'Zero Trackers',
  privacyPillar2Desc: isTurkish ? 'Reklam kimliği, analitik veya veri madenciliği kütüphaneleri yoktur.' : 'No advertising IDs, analytics SDKs, or profiling.',
  privacyPillar3Title: isTurkish ? '%100 Çevrimdışı' : '100% Offline',
  privacyPillar3Desc: isTurkish ? 'İnternet bağlantısına ihtiyaç duymaz, dağda ya da uçakta da çalışır.' : 'Works anywhere without internet, on flights or off-grid.',
  proBadge: isTurkish ? '%100 Ücretsiz' : '100% Free',
  proSub: isTurkish
    ? 'Abonelik veya satın alma yok. Tüm özellikler herkes için ömür boyu sınırsız ve ücretsiz.'
    : 'No subscriptions or in-app purchases. All features are free and unlimited for everyone forever.',
  peekWidget: isTurkish ? 'Widgetlar · İncele' : 'Widgets · Preview',
  stageHome: isTurkish ? 'Geri Sayım' : 'Countdowns',
  stageWidget: isTurkish ? 'Widget Ekranı' : 'Widgets',
  closingTitle: isTurkish ? 'Önemli anlarını unutma. Saymaya bugün başla.' : 'Never forget what matters. Start counting today.',
  closingSub: isTurkish ? 'Doğum günleri, nikahlar, buluşmalar ve seyahatler. Her bakışta kilit ekranında.' : 'Birthdays, weddings, milestones, and trips. At every glance on your screen.',
  storeBtn: isTurkish ? "App Store'dan İndir" : 'Download on App Store',
};
---

<AnimsatLayout
  title={`${ANIMSAT_NAME} — ${copy.tagline}`}
  description={copy.seoDescription}
  path={homePath}
  canonical={homeCanonical}
  htmlLang={localeDef.htmlLang}
  ogLocale={localeDef.ogLocale}
  dir={localeDef.rtl ? 'rtl' : 'ltr'}
  skipLabel={copy.skipToContent}
  imageAlt={`${ANIMSAT_NAME} — ${copy.tagline}`}
  alternates={alternates}
  keywords={['animsat', 'kac-gun-kaldi', 'gerisayim', 'widget', 'hatirlatici', locale]}
  schema={schema}
>
  <SiteHeader slot="header" locale={locale} page="home" />

  <!-- =======================================================================
       1. HERO SECTION: The Cinematic Architectural Stage
       ======================================================================= -->
  <section class="relative mx-auto max-w-6xl px-5 pt-12 pb-20 sm:px-8 sm:pt-20 lg:pt-24 lg:pb-32">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- Left Content -->
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left rtl:lg:items-start rtl:lg:text-right">
        <!-- Live Status Pill -->
        <div class="animsat-reveal inline-flex items-center gap-2.5 rounded-full border border-emerald-500/35 bg-emerald-500/10 px-4 py-1.5 text-xs font-medium text-emerald-300 shadow-sm backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
          </span>
          <span class="tracking-wide">{copy.eyebrow} · {isTurkish ? "App Store'da Yayında" : 'Now on App Store'}</span>
        </div>

        <!-- Master Headline -->
        <h1 class="animsat-reveal animsat-reveal-2 mt-6">
          <span class="animsat-display block text-5xl font-bold tracking-tight text-white sm:text-6xl md:text-7xl lg:text-8xl lg:leading-[0.92]">
            {copy.eyebrow}
          </span>
          <span class="animsat-display-italic block mt-2 pe-4 sm:pe-6 text-3xl font-normal tracking-tight text-transparent bg-gradient-to-r from-[#e89078] via-[#f7c2aa] to-white bg-clip-text sm:text-4xl md:text-5xl lg:text-6xl lg:leading-[1.15]">
            {copy.headline}
          </span>
        </h1>

        <!-- Editorial Lede -->
        <p class="animsat-reveal animsat-reveal-3 mt-6 max-w-lg text-base leading-relaxed text-stone-300/90 sm:text-lg sm:leading-8">
          {copy.lede}
        </p>

        <!-- CTA Group -->
        <div class="animsat-reveal animsat-reveal-4 mt-8 flex flex-wrap items-center justify-center gap-3.5 lg:justify-start">
          {
            appStoreUrl ? (
              <a
                href={appStoreUrl}
                class="animsat-cta-apple group"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 170 170" width="18" height="18" fill="currentColor" aria-hidden="true" class="transition-transform duration-200 group-hover:scale-110">
                  <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.74 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.08-7.74-7.93-12.14-14.55-6.74-10.15-12.02-21.73-15.84-34.73-3.82-13-5.73-25.29-5.73-36.87 0-14.6 3.65-26.85 10.95-36.75 7.3-9.9 16.51-14.99 27.63-15.28 4.71 0 10.04 1.25 16 3.75 5.96 2.5 10.04 3.79 12.24 3.87 1.74 0 5.86-1.35 12.37-4.04 6.51-2.7 11.75-3.9 15.71-3.6 11.66.72 20.91 5.37 27.75 13.96-10.3 6.25-15.35 15.02-15.15 26.31.2 8.9 3.59 16.32 10.17 22.26 6.58 5.94 14.43 9.42 23.55 10.44-2.18 6.54-4.8 13.06-7.86 19.57zM119.22 31.86c0-7.38 2.65-14.28 7.95-20.7 5.3-6.42 11.77-10.48 19.41-12.16.87 7.08-1.57 14.07-7.32 20.97-5.75 6.9-12.42 11.08-20.04 11.89z" />
                </svg>
                <span>{ui.storeBtn}</span>
              </a>
            ) : (
              <div class="animsat-cta-apple group cursor-default">
                <svg viewBox="0 0 170 170" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.74 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.08-7.74-7.93-12.14-14.55-6.74-10.15-12.02-21.73-15.84-34.73-3.82-13-5.73-25.29-5.73-36.87 0-14.6 3.65-26.85 10.95-36.75 7.3-9.9 16.51-14.99 27.63-15.28 4.71 0 10.04 1.25 16 3.75 5.96 2.5 10.04 3.79 12.24 3.87 1.74 0 5.86-1.35 12.37-4.04 6.51-2.7 11.75-3.9 15.71-3.6 11.66.72 20.91 5.37 27.75 13.96-10.3 6.25-15.35 15.02-15.15 26.31.2 8.9 3.59 16.32 10.17 22.26 6.58 5.94 14.43 9.42 23.55 10.44-2.18 6.54-4.8 13.06-7.86 19.57zM119.22 31.86c0-7.38 2.65-14.28 7.95-20.7 5.3-6.42 11.77-10.48 19.41-12.16.87 7.08-1.57 14.07-7.32 20.97-5.75 6.9-12.42 11.08-20.04 11.89z" />
                </svg>
                <span>{copy.ctaSoon}</span>
              </div>
            )
          }

          {
            ANIMSAT_PLAY_STORE_URL ? (
              <a
                href={ANIMSAT_PLAY_STORE_URL}
                class="animsat-cta-secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Google Play</span>
              </a>
            ) : null
          }

          <a
            href={ANIMSAT_GITHUB_URL}
            class="animsat-cta-secondary group"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-4 w-4 fill-current transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>

        <!-- Trust Signals Micro Strip -->
        <div class="animsat-reveal animsat-reveal-4 mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-medium text-stone-400 lg:justify-start">
          <span class="inline-flex items-center gap-1.5">
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-400">
              <path d="M3 8.5l3.5 3.5L13 5"></path>
            </svg>
            {ui.trustOffline}
          </span>
          <span class="text-stone-600">·</span>
          <span class="inline-flex items-center gap-1.5">
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-400">
              <path d="M3 8.5l3.5 3.5L13 5"></path>
            </svg>
            {ui.trustTrackers}
          </span>
          <span class="text-stone-600">·</span>
          <span class="inline-flex items-center gap-1.5">
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-400">
              <path d="M3 8.5l3.5 3.5L13 5"></path>
            </svg>
            {ui.trustWidgets}
          </span>
        </div>
      </div>

      <!-- Right Device Showcase (Exact Phone Image & Size Preserved) -->
      <div class="animsat-reveal animsat-reveal-3 relative mx-auto w-full max-w-lg lg:max-w-xl" dir="ltr">
        <div id="hero-stage" class="animsat-hero-stage" data-active="home">
          <div class="animsat-stage-light"></div>

          <div class="animsat-hero-phones">
            <!-- Front Phone (Core Countdown List) -->
            <div
              id="hero-phone-home"
              class="animsat-hero-phone-front"
              role="button"
              tabindex="0"
              aria-label={copy.alts.phoneHome}
            >
              <PhoneFrame src={shotHome} alt={copy.alts.phoneHome} priority />
            </div>

            <!-- Back Phone (Home & Lock Screen Widgets) -->
            <div
              id="hero-phone-widget"
              class="animsat-hero-phone-back"
              role="button"
              tabindex="0"
              aria-label={copy.alts.phoneWidget}
            >
              <span class="animsat-hero-phone-back-badge">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" class="text-amber-400">
                  <path d="M9.5 1.5L2.5 9h5l-1 5.5 7-7.5h-5l1-5.5z"/>
                </svg>
                <span>{ui.peekWidget}</span>
              </span>
              <PhoneFrame src={shotWidget} alt={copy.alts.phoneWidget} />
            </div>

            <!-- Floating Micro-Pill 1: Birthday Countdown -->
            <div class="animsat-float-pill animsat-float-pill-1">
              <span class="animsat-pill-icon">🎂</span>
              <div class="text-left">
                <p class="text-xs font-semibold text-white">{ui.floatingBirthday}</p>
                <p class="text-[10px] text-stone-400">{ui.floatingBirthdaySub}</p>
              </div>
            </div>

            <!-- Floating Micro-Pill 2: Live Widget -->
            <div class="animsat-float-pill animsat-float-pill-2">
              <span class="animsat-pill-icon">⚡</span>
              <div class="text-left">
                <p class="text-xs font-semibold text-white">{ui.floatingWidget}</p>
                <p class="text-[10px] text-stone-400">{ui.floatingWidgetSub}</p>
              </div>
            </div>

            <!-- Floating Micro-Pill 3: Offline Privacy -->
            <div class="animsat-float-pill animsat-float-pill-3">
              <span class="animsat-pill-icon">🔒</span>
              <div class="text-left">
                <p class="text-xs font-semibold text-white">{ui.floatingPrivacy}</p>
                <p class="text-[10px] text-stone-400">{ui.floatingPrivacySub}</p>
              </div>
            </div>
          </div>

          <!-- Mobile / Tablet Switcher Pills -->
          <div class="animsat-stage-switcher" aria-label="Ekran seçimi">
            <button type="button" id="btn-show-home" class="animsat-stage-btn active">
              <span>📱</span>
              <span>{ui.stageHome}</span>
            </button>
            <button type="button" id="btn-show-widget" class="animsat-stage-btn">
              <span>⚡</span>
              <span>{ui.stageWidget}</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       2. MOMENTS RIBBON: Curated Infinite Life Events
       ======================================================================= -->
  <div class="animsat-marquee" aria-hidden="true" dir="ltr">
    <div class="animsat-marquee-track">
      {
        marqueeCopies.map(() => (
          <div class="animsat-marquee-group">
            {copy.moments.map((item, idx) => (
              <span class="animsat-moment-chip">
                <span class="animsat-moment-dot"></span>
                <span class="font-mono text-[11px] text-stone-500">#{String(idx + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- =======================================================================
       3. FEATURES & EXPERIENCES: Bespoke Bento Showcases
       ======================================================================= -->
  <section id="ozellikler" class="relative mx-auto max-w-6xl px-5 py-24 sm:px-8 lg:py-32">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-semibold tracking-[0.28em] text-[#d96b52] uppercase">{copy.featuresKicker}</p>
      <h2 class="animsat-display mt-4 text-3xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        {copy.featuresTitle}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-stone-400 sm:text-lg">
        {ui.featuresSub}
      </p>

      <!-- Quick Switcher Jump Anchors -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        <a href="#feature-dates" class="animsat-tab-chip">
          <span class="font-mono text-[#d96b52]">01</span>
          <span>{featureDates.title}</span>
        </a>
        <a href="#widgetlar" class="animsat-tab-chip">
          <span class="font-mono text-[#d96b52]">02</span>
          <span>{featureWidget.title}</span>
        </a>
        <a href="#feature-photo" class="animsat-tab-chip">
          <span class="font-mono text-[#d96b52]">03</span>
          <span>{featurePhoto.title}</span>
        </a>
        <a href="#feature-color" class="animsat-tab-chip">
          <span class="font-mono text-[#d96b52]">04</span>
          <span>{featureColor.title}</span>
        </a>
      </div>
    </div>

    <!-- Feature Bento Deck -->
    <div class="mt-16 space-y-12 sm:mt-24 sm:space-y-16 lg:space-y-20">
      
      <!-- SHOWCASE 1: The Core Countdown Engine (Dates) -->
      <article id="feature-dates" class="animsat-bento-card p-8 sm:p-12 lg:p-16">
        <div class="animsat-card-spotlight -top-20 -left-20 h-96 w-96 bg-[#d96b52]/15"></div>

        <div class="relative z-10 grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
          <!-- Text Info -->
          <div class="lg:col-span-7 flex flex-col items-center text-center lg:items-start lg:text-left rtl:lg:items-start rtl:lg:text-right">
            <div class="inline-flex items-center gap-2.5">
              <span class="font-mono text-xs font-semibold tracking-[0.25em] text-[#d96b52] uppercase">01 / {copy.featuresKicker}</span>
              <span class="h-px w-8 bg-[#d96b52]/40" aria-hidden="true"></span>
            </div>

            <h3 class="animsat-display mt-4 text-2xl font-bold text-white sm:text-4xl lg:text-5xl lg:leading-[1.1]">
              {featureDates.title}
            </h3>

            <p class="mt-5 max-w-xl text-base leading-relaxed text-stone-300 sm:text-lg sm:leading-8">
              {featureDates.body}
            </p>

            <!-- Feature Checklist Pillars -->
            <div class="mt-8 grid w-full gap-4 sm:grid-cols-2 text-left">
              <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4">
                <span class="text-base">⏱️</span>
                <h4 class="mt-2 text-sm font-semibold text-white">{ui.feature1Pillar1Title}</h4>
                <p class="mt-1 text-xs leading-relaxed text-stone-400">{ui.feature1Pillar1Desc}</p>
              </div>

              <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4">
                <span class="text-base">📌</span>
