---
import AnimsatLayout from '../../layouts/AnimsatLayout.astro';
import PhoneFrame from './PhoneFrame.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import {
  ANIMSAT_APP_STORE_URL,
  ANIMSAT_NAME,
  ANIMSAT_PLAY_STORE_URL,
  ANIMSAT_POLICY_LOCALES,
  ANIMSAT_SITE_URL,
  getAnimsatLocale,
  getLanding,
  landingCanonical,
  landingPath,
  policyPath,
  type AnimsatLocale,
} from '../../data/animsat';
import { softwareApplicationSchema } from '../../lib/seo';
import shotHome from '../../assets/animsat/onboarding-home.jpg';
import shotPhoto from '../../assets/animsat/onboarding-add-photo.jpg';
import shotColor from '../../assets/animsat/onboarding-add.jpg';
import shotWidget from '../../assets/animsat/onboarding-widget.jpg';

interface Props {
  locale: AnimsatLocale;
}

const { locale } = Astro.props;
const localeDef = getAnimsatLocale(locale);
const copy = getLanding(locale);
const privacyHref = policyPath(locale);
const homePath = landingPath(locale);
const homeCanonical = landingCanonical(locale);
const marqueeCopies = [0, 1, 2, 3];

const featureOrder = ['dates', 'widget', 'photo', 'color'] as const;
const features = featureOrder.map((id, index) => {
  const feature = copy.features.find((item) => item.id === id);
  if (!feature) throw new Error(`Missing Anımsat feature: ${id}`);
  return {
    ...feature,
    kicker: String(index + 1).padStart(2, '0'),
  };
});

const featureShots = {
  dates: { src: shotHome, alt: copy.alts.phoneHome },
  photo: { src: shotPhoto, alt: copy.alts.phonePhoto },
  color: { src: shotColor, alt: copy.alts.phoneColor },
  widget: { src: shotWidget, alt: copy.alts.phoneWidget },
} as const;

const alternates = [
  ...ANIMSAT_POLICY_LOCALES.map((item) => ({
    hreflang: item.hreflang,
    href: landingCanonical(item.id),
  })),
  { hreflang: 'x-default', href: landingCanonical('tr') },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: ANIMSAT_NAME,
    alternateName: copy.tagline,
    url: ANIMSAT_SITE_URL,
    description: copy.seoDescription,
    inLanguage: localeDef.htmlLang,
  },
  softwareApplicationSchema(),
];
---

<AnimsatLayout
  title={`${ANIMSAT_NAME} — ${copy.tagline}`}
  description={copy.seoDescription}
  path={homePath}
  canonical={homeCanonical}
  htmlLang={localeDef.htmlLang}
  ogLocale={localeDef.ogLocale}
  dir={localeDef.rtl ? 'rtl' : 'ltr'}
  skipLabel={copy.skipToContent}
  imageAlt={`${ANIMSAT_NAME} — ${copy.tagline}`}
  alternates={alternates}
  keywords={['animsat', 'kac-gun-kaldi', 'gerisayim', 'widget', 'hatirlatici', locale]}
  schema={schema}
>
  <SiteHeader slot="header" locale={locale} page="home" />

  <section class="relative mx-auto max-w-6xl px-5 pb-20 pt-16 sm:px-8 sm:pt-24 lg:pb-28">
    <div class="mt-2 grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <h1 class="animsat-display animsat-reveal text-5xl leading-[0.95] tracking-tight text-[#faf8f5] sm:text-6xl lg:text-7xl">
          {copy.eyebrow}
        </h1>
        <p class="animsat-display animsat-reveal animsat-reveal-2 mt-4 max-w-xl text-3xl leading-[1.08] text-[#c45c4a] sm:text-4xl lg:text-[2.75rem]">
          {copy.headline}
        </p>
        <p class="animsat-reveal animsat-reveal-3 mt-6 max-w-md text-base leading-7 text-[#a8a29e] sm:text-lg">
          {copy.lede}
        </p>
        <div class="animsat-reveal animsat-reveal-4 mt-10 flex flex-wrap items-center gap-3">
          {
            ANIMSAT_APP_STORE_URL ? (
              <a
                href={ANIMSAT_APP_STORE_URL}
                class="rounded-full bg-[#faf8f5] px-5 py-2.5 text-sm font-semibold text-[#121212] transition hover:bg-white"
              >
                App Store
              </a>
            ) : (
              <span class="rounded-full bg-[#faf8f5] px-5 py-2.5 text-sm font-semibold text-[#121212]">
                {copy.ctaSoon}
              </span>
            )
          }
          {
            ANIMSAT_PLAY_STORE_URL ? (
              <a
                href={ANIMSAT_PLAY_STORE_URL}
                class="rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-[#faf8f5] transition hover:border-white/50"
              >
                Google Play
              </a>
            ) : null
          }
        </div>
      </div>

      <div class="animsat-reveal animsat-reveal-3 relative mx-auto flex w-full max-w-md justify-center lg:mx-0 lg:justify-end" dir="ltr">
        <PhoneFrame src={shotHome} alt={copy.alts.phoneHome} class="relative z-10 rotate-[-7deg]" priority />
        <PhoneFrame
          src={shotWidget}
          alt={copy.alts.phoneWidget}
          class="absolute top-16 right-0 hidden w-[210px] rotate-[9deg] sm:block"
        />
      </div>
    </div>
  </section>

  <div class="animsat-marquee" aria-hidden="true" dir="ltr">
    <div class="animsat-marquee-track">
      {
        marqueeCopies.map(() => (
          <div class="animsat-marquee-group">
            {copy.moments.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <section id="ozellikler" class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">{copy.featuresKicker}</p>
      <h2 class="animsat-display mt-4 text-3xl text-[#faf8f5] sm:text-5xl">{copy.featuresTitle}</h2>
    </div>

    <div class="mt-12 grid gap-14 lg:gap-16">
      {
        features.map((feature) => {
          const shot = featureShots[feature.id];
          return (
            <article class="animsat-feature mx-auto flex w-full max-w-md flex-col items-center text-center">
              <p class="font-mono text-xs tracking-[0.2em] text-[#faf8f5]/40">{feature.kicker}</p>
              <h3 class="animsat-display mt-3 text-2xl text-[#faf8f5] sm:text-3xl">{feature.title}</h3>
              <p class="mt-3 text-base leading-7 text-[#a8a29e]">{feature.body}</p>
              <PhoneFrame src={shot.src} alt={shot.alt} class="animsat-feature-phone mt-8" />
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="border-y border-white/10 bg-black/35">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">{copy.privacyKicker}</p>
        <h2 class="animsat-display mt-4 text-3xl text-[#faf8f5] sm:text-4xl">{copy.privacyTitle}</h2>
        <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{copy.privacyBody}</p>
        <a href={privacyHref} class="mt-6 inline-block text-sm font-medium text-[#faf8f5] underline-offset-4 hover:underline">
          {copy.ctaPrivacy}
        </a>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">{copy.proKicker}</p>
        <h2 class="animsat-display mt-4 text-3xl text-[#faf8f5] sm:text-4xl">{copy.proTitle}</h2>
        <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{copy.proBody}</p>
        <ul class="mt-6 grid gap-2 text-sm text-[#faf8f5]/80 sm:grid-cols-2">
          {copy.proItems.map((item) => (
            <li class="border-b border-white/10 py-2">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" locale={locale} />
</AnimsatLayout>
