---
import AnimsatLayout from '../../layouts/AnimsatLayout.astro';
import PhoneFrame from './PhoneFrame.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import InteractivePreview from './InteractivePreview.astro';
import WidgetShowcase from './WidgetShowcase.astro';
import FreeGuarantee from './FreeGuarantee.astro';
import {
  ANIMSAT_APP_STORE_URL,
  ANIMSAT_NAME,
  ANIMSAT_PLAY_STORE_URL,
  ANIMSAT_POLICY_LOCALES,
  ANIMSAT_SITE_URL,
  getAnimsatLocale,
  getLanding,
  landingCanonical,
  landingPath,
  policyPath,
  type AnimsatLocale,
} from '../../data/animsat';
import { softwareApplicationSchema } from '../../lib/seo';
import shotHome from '../../assets/animsat/onboarding-home.jpg';
import shotPhoto from '../../assets/animsat/onboarding-add-photo.jpg';
import shotColor from '../../assets/animsat/onboarding-add.jpg';
import shotWidget from '../../assets/animsat/onboarding-widget.jpg';

interface Props {
  locale: AnimsatLocale;
}

const { locale } = Astro.props;
const localeDef = getAnimsatLocale(locale);
const copy = getLanding(locale);
const privacyHref = policyPath(locale);
const homePath = landingPath(locale);
const homeCanonical = landingCanonical(locale);
const marqueeCopies = [0, 1, 2, 3];

const featureOrder = ['dates', 'widget', 'photo', 'color'] as const;
const features = featureOrder.map((id, index) => {
  const feature = copy.features.find((item) => item.id === id);
  if (!feature) throw new Error(`Missing Anımsat feature: ${id}`);
  return {
    ...feature,
    kicker: String(index + 1).padStart(2, '0'),
  };
});

const featureShots = {
  dates: { src: shotHome, alt: copy.alts.phoneHome },
  photo: { src: shotPhoto, alt: copy.alts.phonePhoto },
  color: { src: shotColor, alt: copy.alts.phoneColor },
  widget: { src: shotWidget, alt: copy.alts.phoneWidget },
} as const;

const alternates = [
  ...ANIMSAT_POLICY_LOCALES.map((item) => ({
    hreflang: item.hreflang,
    href: landingCanonical(item.id),
  })),
  { hreflang: 'x-default', href: landingCanonical('tr') },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: ANIMSAT_NAME,
    alternateName: copy.tagline,
    url: ANIMSAT_SITE_URL,
    description: copy.seoDescription,
    inLanguage: localeDef.htmlLang,
  },
  softwareApplicationSchema(),
];

const badgeLabel = locale === 'tr' ? '%100 Ücretsiz & Reklamsız • iOS & Android' : '100% Free & Ad-Free • iOS & Android';
---

<AnimsatLayout
  title={`${ANIMSAT_NAME} — ${copy.tagline}`}
  description={copy.seoDescription}
  path={homePath}
  canonical={homeCanonical}
  htmlLang={localeDef.htmlLang}
  ogLocale={localeDef.ogLocale}
  dir={localeDef.rtl ? 'rtl' : 'ltr'}
  skipLabel={copy.skipToContent}
  imageAlt={`${ANIMSAT_NAME} — ${copy.tagline}`}
  alternates={alternates}
  keywords={['animsat', 'kac-gun-kaldi', 'gerisayim', 'widget', 'hatirlatici', locale]}
  schema={schema}
>
  <SiteHeader slot="header" locale={locale} page="home" />

  <!-- Hero Section -->
  <section class="relative mx-auto max-w-6xl px-5 pb-20 pt-12 sm:px-8 sm:pt-20 lg:pb-28">
    <div class="mt-2 grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <!-- Pill Badge -->
        <div class="animsat-reveal inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium text-white/90 backdrop-blur-md mb-6 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
          <span>{badgeLabel}</span>
        </div>

        <h1 class="animsat-display animsat-reveal text-[4.5rem] sm:text-[6rem] lg:text-[6.75rem] leading-[0.92] tracking-tight text-[#faf8f5]">
          {copy.eyebrow}
        </h1>
        <p class="animsat-display animsat-reveal animsat-reveal-2 mt-4 max-w-xl text-3xl leading-[1.08] text-[#f43f5e] sm:text-4xl lg:text-[2.75rem]">
          {copy.headline}
        </p>
        <p class="animsat-reveal animsat-reveal-3 mt-6 max-w-md text-base leading-7 text-zinc-300 sm:text-lg">
          {copy.lede}
        </p>

        <!-- CTA Buttons -->
        <div class="animsat-reveal animsat-reveal-4 mt-8 flex flex-wrap items-center gap-3">
          {
            ANIMSAT_APP_STORE_URL ? (
              <a
                href={ANIMSAT_APP_STORE_URL}
                class="inline-flex items-center gap-2.5 rounded-full bg-[#faf8f5] px-6 py-3 text-sm font-semibold text-[#121212] transition hover:bg-white hover:scale-105 active:scale-95 shadow-lg shadow-white/10"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 170 170">
                  <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.07-7.68-7.85-11.96-14.35-7.39-11.21-13.16-24.16-17.31-38.84-4.14-14.68-6.22-28.02-6.22-40.01 0-14.34 3.73-26.24 11.19-35.69 7.46-9.46 16.74-14.28 27.84-14.47 5.11 0 10.77 1.34 16.98 4.02 6.21 2.68 10.15 4.07 11.83 4.16 1.45 0 5.48-1.42 12.09-4.27 6.6-2.85 12.28-4.14 17.03-3.87 13.06.67 23.47 5.38 31.23 14.15-11.4 6.89-16.95 16.39-16.66 28.52.28 9.94 4.15 18.28 11.59 25.03 7.45 6.74 16.33 10.49 26.65 11.23-2.19 6.88-4.71 13.75-7.55 20.61zM119.22 33.7c0-7.27 2.64-13.97 7.93-20.1 5.29-6.13 11.85-9.97 19.68-11.52.44 1.4.67 2.87.67 4.41 0 7.27-2.73 14.07-8.19 20.4-5.46 6.33-12.08 10.02-19.86 11.08-.15-1.47-.23-2.89-.23-4.27z"/>
                </svg>
                App Store
              </a>
            ) : (
              <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white/90">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                {copy.ctaSoon}
              </span>
            )
          }
          {
            ANIMSAT_PLAY_STORE_URL ? (
              <a
                href={ANIMSAT_PLAY_STORE_URL}
                class="inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-[#faf8f5] transition hover:border-white/50 hover:bg-white/10 hover:scale-105 active:scale-95"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 512 512">
                  <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/>
                </svg>
                Google Play
              </a>
            ) : null
          }
          <button
            type="button"
            id="watch-video-btn"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-3 text-sm font-semibold text-zinc-300 transition hover:border-white/40 hover:bg-white/10 hover:text-white active:scale-95"
          >
            <svg class="w-4 h-4 text-rose-500 fill-current" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            {locale === 'tr' ? 'Tanıtımı İzle' : 'Watch Preview'}
          </button>
        </div>
      </div>

      <!-- Hero Interactive Phone Preview -->
      <div class="animsat-reveal animsat-reveal-3 relative mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
        <InteractivePreview locale={locale} />
      </div>
    </div>
  </section>

  <!-- Marquee text strip -->
  <div class="animsat-marquee border-y border-white/10 bg-black/40 py-1" aria-hidden="true" dir="ltr">
    <div class="animsat-marquee-track">
      {
        marqueeCopies.map(() => (
          <div class="animsat-marquee-group">
            {copy.moments.map((item) => (
              <span class="inline-flex items-center gap-6">
                <span>{item}</span>
                <span class="text-rose-500/60">•</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Features Section -->
  <section id="ozellikler" class="mx-auto max-w-6xl px-5 py-24 sm:px-8 lg:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <span class="font-mono text-xs font-semibold tracking-[0.28em] text-[#f43f5e] uppercase">
        {copy.featuresKicker}
      </span>
      <h2 class="animsat-display mt-4 text-3xl font-bold text-[#faf8f5] sm:text-5xl">
        {copy.featuresTitle}
      </h2>
    </div>

    <div class="mt-16 space-y-24 sm:mt-24 sm:space-y-32 lg:space-y-36">
      {
        features.map((feature, index) => {
          const shot = featureShots[feature.id];
          const isReversed = index % 2 === 1;

          return (
            <article class="animsat-feature-row grid items-center gap-10 sm:gap-12 lg:grid-cols-2 lg:gap-16 xl:gap-24">
              <div
                class:list={[
                  'flex flex-col items-center text-center lg:items-start lg:text-left rtl:lg:items-start rtl:lg:text-right',
                  isReversed ? 'lg:order-2 lg:pl-6 xl:pl-12' : 'lg:order-1 lg:pr-6 xl:pr-12',
                ]}
              >
                <div class="inline-flex items-center gap-2.5">
                  <span class="font-mono text-xs font-semibold tracking-[0.25em] text-[#f43f5e] uppercase">
                    {feature.kicker}
                  </span>
                  <span class="h-px w-8 bg-[#f43f5e]/40" aria-hidden="true"></span>
                </div>
                <h3 class="animsat-display mt-3 text-2xl font-bold text-[#faf8f5] sm:text-3xl lg:text-4xl lg:leading-[1.15]">
                  {feature.title}
                </h3>
                <p class="mt-4 max-w-md text-base leading-7 text-zinc-400 sm:text-lg sm:leading-8">
                  {feature.body}
                </p>
              </div>

              <div
                class:list={[
                  'relative flex w-full justify-center',
                  isReversed ? 'lg:order-1' : 'lg:order-2',
                ]}
                dir="ltr"
              >
                <div class="relative group">
                  <div class="pointer-events-none absolute -inset-4 rounded-[40px] bg-rose-500/10 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                  <PhoneFrame src={shot.src} alt={shot.alt} class="animsat-feature-phone transition duration-300 group-hover:scale-[1.02]" />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- Widget Showcase Section -->
  <WidgetShowcase locale={locale} />

  <!-- 100% Free & Privacy Bento Section -->
  <FreeGuarantee locale={locale} />

  <!-- Video Modal -->
  <div
    id="video-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Anımsat Video Preview"
  >
    <div class="relative w-full max-w-xs sm:max-w-sm overflow-hidden rounded-[36px] border border-white/20 bg-[#09090b] shadow-2xl">
      <button
        id="close-video-btn"
        class="absolute top-4 right-4 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-black/70 text-white/80 hover:bg-black hover:text-white backdrop-blur transition cursor-pointer"
        aria-label="Kapat"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="aspect-[886/1920] w-full bg-black">
        <video
          id="promo-video-player"
          class="h-full w-full object-cover"
          playsinline
          controls
          preload="metadata"
        >
          <source src="/animsat-promo.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>

  <script>
    const openBtn = document.getElementById('watch-video-btn');
    const closeBtn = document.getElementById('close-video-btn');
    const modal = document.getElementById('video-modal');
    const video = document.getElementById('promo-video-player') as HTMLVideoElement | null;

    function openModal() {
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      if (video) {
        video.currentTime = 0;
        video.play().catch(() => {});
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      if (video) {
        video.pause();
      }
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>

  <SiteFooter slot="footer" locale={locale} />
</AnimsatLayout>
