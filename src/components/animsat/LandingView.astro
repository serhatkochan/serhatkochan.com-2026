  <script is:inline>
    (function () {
      const stage = document.getElementById('hero-stage');
      const phoneHome = document.getElementById('hero-phone-home');
      const phoneWidget = document.getElementById('hero-phone-widget');
      const btnHome = document.getElementById('btn-show-home');
      const btnWidget = document.getElementById('btn-show-widget');

      function setActive(mode) {
        if (!stage) return;
        stage.setAttribute('data-active', mode);
        if (btnHome) btnHome.classList.toggle('active', mode === 'home');
        if (btnWidget) btnWidget.classList.toggle('active', mode === 'widget');
      }

      if (phoneHome) {
        phoneHome.addEventListener('click', function () { setActive('home'); });
        phoneHome.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setActive('home'); }
        });
      }

      if (phoneWidget) {
        phoneWidget.addEventListener('click', function () { setActive('widget'); });
        phoneWidget.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setActive('widget'); }
        });
      }

      if (btnHome) {
        btnHome.addEventListener('click', function () { setActive('home'); });
      }
      if (btnWidget) {
        btnWidget.addEventListener('click', function () { setActive('widget'); });
      }
    })();
  </script>
