---
import { ANIMSAT_POLICY_LOCALES, policyPath, type AnimsatLocale } from '../../data/animsat';

interface Props {
  current: AnimsatLocale;
  label: string;
}

const { current, label } = Astro.props;
---

<nav class="border-b border-zinc-100 pb-6 dark:border-zinc-800" aria-labelledby="policy-language-label">
  <p id="policy-language-label" class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{label}</p>
  <ul class="mt-3 flex flex-wrap gap-x-1 gap-y-2" role="list">
    {
      ANIMSAT_POLICY_LOCALES.map((item) => {
        const active = item.id === current;
        return (
          <li>
            <a
              href={policyPath(item.id)}
              hreflang={item.hreflang}
              lang={item.htmlLang}
              data-astro-prefetch="false"
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex rounded-full px-3 py-1 text-sm transition',
                active
                  ? 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900'
                  : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100',
              ]}
            >
              {item.nativeName}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
