---
import { ANIMSAT_POLICY_LOCALES, policyPath, type AnimsatLocale } from '../../data/animsat';

interface Props {
  current: AnimsatLocale;
  label: string;
}

const { current, label } = Astro.props;
---

<nav class="border-b border-white/10 pb-6" aria-labelledby="policy-language-label">
  <p id="policy-language-label" class="text-sm font-medium text-[#a8a29e]">{label}</p>
  <ul class="mt-3 flex flex-wrap gap-x-1 gap-y-2" role="list">
    {
      ANIMSAT_POLICY_LOCALES.map((item) => {
        const active = item.id === current;
        return (
          <li>
            <a
              href={policyPath(item.id)}
              hreflang={item.hreflang}
              lang={item.htmlLang}
              data-astro-prefetch="false"
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex rounded-full px-3 py-1 text-sm transition',
                active
                  ? 'bg-[#faf8f5] text-[#121212]'
                  : 'text-[#faf8f5]/65 hover:bg-white/10 hover:text-[#faf8f5]',
              ]}
            >
              {item.nativeName}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
