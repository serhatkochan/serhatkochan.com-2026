---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  priority?: boolean;
}

const { src, alt, class: className, priority = false } = Astro.props;
---

<figure class:list={['animsat-phone', className]}>
  <div class="animsat-phone-bezel">
    <span class="animsat-phone-notch" aria-hidden="true"></span>
    <Image
      src={src}
      alt={alt}
      widths={[280, 420, 560]}
      sizes="(min-width: 1024px) 280px, 70vw"
      format="webp"
      quality={78}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="animsat-phone-screen"
    />
  </div>
</figure>
