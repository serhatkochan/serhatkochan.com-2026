---
import type { AnimsatLocale } from '../../data/animsat';

interface Props {
  locale: AnimsatLocale;
}

const { locale } = Astro.props;

const TEXTS = {
  tr: {
    kicker: 'WIDGET DENEYİMİ',
    title: 'Her bakışta yanında.',
    subtitle: 'Uygulamayı açmana gerek kalmasın. Kilit ekranında veya ana ekranında dilediğin boyutta sabitle; gün sayımını bir bakışta gör.',
    smallWidgetTitle: "Ada'nın Doğum Günü",
    smallWidgetTag: '18 gün kaldı',
    mediumWidgetTitle: 'Kaş Kaçamağı',
    mediumWidgetDate: '15 Temmuz 2027 • Kaş, Antalya',
    mediumWidgetDays: '76',
    mediumWidgetUnit: 'GÜN KALDI',
    lockScreenEvent: "Ada'nın Doğum Günü",
    lockScreenDays: '18 gün',
    lockScreenLabel: 'Kilit Ekranı',
    homeScreenLabel: 'Ana Ekran (2×2 ve 4×2)',
  },
  default: {
    kicker: 'WIDGET EXPERIENCE',
    title: 'Always right by your side.',
    subtitle: 'No need to open the app. Pin countdowns to your lock screen or home screen in any size and keep track at a glance.',
    smallWidgetTitle: "Ada's Birthday",
    smallWidgetTag: '18 days left',
    mediumWidgetTitle: 'Summer Vacation',
    mediumWidgetDate: 'July 15, 2027 • Mediterranean',
    mediumWidgetDays: '76',
    mediumWidgetUnit: 'DAYS LEFT',
    lockScreenEvent: "Ada's Birthday",
    lockScreenDays: '18 days',
    lockScreenLabel: 'Lock Screen',
    homeScreenLabel: 'Home Screen (2×2 & 4×2)',
  },
};

const t = TEXTS[locale as keyof typeof TEXTS] ?? TEXTS.default;
---

<section class="relative mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:py-28 overflow-hidden">
  <!-- Section Header -->
  <div class="mx-auto max-w-2xl text-center">
    <span class="inline-block font-mono text-xs font-semibold tracking-[0.25em] text-[#f43f5e] uppercase">
      {t.kicker}
    </span>
    <h2 class="animsat-display mt-3 text-3xl font-bold tracking-tight text-[#fafafa] sm:text-5xl">
      {t.title}
    </h2>
    <p class="mt-4 text-base leading-7 text-zinc-400 sm:text-lg">
      {t.subtitle}
    </p>
  </div>

  <!-- Showcase Cards Layout -->
  <div class="mt-14 grid gap-6 md:grid-cols-12 items-center">
    <!-- Left Column: Medium Widget (4x2) & Lock Screen Widget -->
    <div class="md:col-span-7 space-y-6">
      <!-- Medium 4x2 Widget Mockup -->
      <div class="relative group overflow-hidden rounded-[32px] border border-white/10 bg-[#121215]/90 p-6 backdrop-blur-xl shadow-2xl transition hover:border-white/20">
        <!-- Ambient corner glow -->
        <div class="pointer-events-none absolute -top-12 -right-12 h-44 w-44 rounded-full bg-cyan-500/20 blur-3xl"></div>

        <div class="flex items-center justify-between text-xs text-zinc-400 mb-4">
          <span class="font-medium flex items-center gap-1.5 text-zinc-300">
            <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
            {t.homeScreenLabel}
          </span>
          <span class="font-mono text-[11px] opacity-60">iOS / Android</span>
        </div>

        <!-- The Medium Widget Container -->
        <div
          class="relative overflow-hidden rounded-[24px] p-6 shadow-xl flex items-center justify-between"
          style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 60%, #075985 100%); color: #ffffff;"
        >
          <div class="space-y-1">
            <span class="inline-block rounded-full bg-black/25 px-2.5 py-0.5 text-[11px] font-semibold backdrop-blur-md">
              🏖️ Kaş, Antalya
            </span>
            <h3 class="font-serif text-2xl font-bold pt-1">{t.mediumWidgetTitle}</h3>
            <p class="text-xs text-white/80">{t.mediumWidgetDate}</p>
          </div>

          <div class="text-right">
            <div class="font-serif text-5xl font-extrabold leading-none">{t.mediumWidgetDays}</div>
            <div class="mt-1 text-[10px] font-bold tracking-wider text-white/70 uppercase">{t.mediumWidgetUnit}</div>
          </div>
        </div>
      </div>

      <!-- Lock Screen Widget Mockup -->
      <div class="relative group overflow-hidden rounded-[32px] border border-white/10 bg-[#121215]/90 p-6 backdrop-blur-xl shadow-xl transition hover:border-white/20">
        <div class="flex items-center justify-between text-xs text-zinc-400 mb-3">
          <span class="font-medium text-zinc-300">{t.lockScreenLabel}</span>
          <span class="font-mono text-[11px] opacity-60">Always-On Display</span>
        </div>

        <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 px-4 py-3 backdrop-blur-md">
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
              🎂
            </div>
            <div>
              <div class="text-xs font-semibold text-white/90">{t.lockScreenEvent}</div>
              <div class="text-[11px] text-zinc-400 font-mono">21 Haziran</div>
            </div>
          </div>
          <div class="font-serif text-base font-bold text-white/95">
            {t.lockScreenDays}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Small Widget (2x2) with Phone Ambient Glow -->
    <div class="md:col-span-5 flex flex-col items-center justify-center">
      <div class="relative w-full max-w-[280px] overflow-hidden rounded-[36px] border border-white/15 bg-gradient-to-br from-rose-500/10 via-zinc-900/90 to-zinc-950 p-6 shadow-2xl backdrop-blur-xl">
        <div class="pointer-events-none absolute -bottom-10 -left-10 h-40 w-40 rounded-full bg-rose-500/25 blur-3xl"></div>

        <div class="text-center mb-4">
          <span class="font-mono text-[11px] font-semibold text-rose-400 uppercase tracking-widest">Small 2×2</span>
        </div>

        <!-- The Small Square Widget -->
        <div
          class="aspect-square w-full rounded-[28px] p-5 shadow-2xl flex flex-col justify-between"
          style="background: linear-gradient(145deg, #e11d48 0%, #be123c 60%, #881337 100%); color: #ffffff;"
        >
          <div class="flex items-center justify-between">
            <span class="text-xl">🎂</span>
            <span class="text-[10px] font-bold tracking-wider uppercase opacity-75">Kalan</span>
          </div>

          <div class="my-auto text-center">
            <div class="font-serif text-5xl font-black leading-none drop-shadow-sm">18</div>
            <div class="text-[10px] font-bold uppercase tracking-widest opacity-80 mt-1">GÜN</div>
          </div>

          <div class="border-t border-white/20 pt-2 text-center">
            <div class="font-serif text-sm font-semibold truncate leading-tight">{t.smallWidgetTitle}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
