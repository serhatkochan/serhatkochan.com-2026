---
import type { AnimsatLocale } from '../../data/animsat';

interface Props {
  locale: AnimsatLocale;
}

const { locale } = Astro.props;

// Localized preset cards for the interactive demo
const PRESETS = {
  tr: [
    {
      id: 'birthday',
      emoji: '🎂',
      title: "Ada'nın Doğum Günü",
      dateStr: '21 Haziran',
      days: 18,
      gradient: 'linear-gradient(135deg, #f43f5e 0%, #fb7185 50%, #f472b6 100%)',
      textColor: '#ffffff',
      tag: 'Kutlama',
      location: 'İstanbul',
    },
    {
      id: 'vacation',
      emoji: '🏖️',
      title: 'Kaş Yaz Tatili',
      dateStr: '15 Temmuz',
      days: 76,
      gradient: 'linear-gradient(135deg, #0ea5e9 0%, #06b6d4 50%, #14b8a6 100%)',
      textColor: '#ffffff',
      tag: 'Seyahat',
      location: 'Antalya, Kaş',
    },
    {
      id: 'anniversary',
      emoji: '💍',
      title: 'Evlilik Yıldönümü',
      dateStr: '24 Eylül',
      days: 142,
      gradient: 'linear-gradient(135deg, #8b5cf6 0%, #a855f7 50%, #ec4899 100%)',
      textColor: '#ffffff',
      tag: 'Özel Gün',
      location: 'Roma',
    },
    {
      id: 'marathon',
      emoji: '🏃',
      title: 'Maraton 42K',
      dateStr: '8 Kasım',
      days: 210,
      gradient: 'linear-gradient(135deg, #f97316 0%, #ea580c 50%, #dc2626 100%)',
      textColor: '#ffffff',
      tag: 'Hedef',
      location: 'İstanbul',
    },
  ],
  default: [
    {
      id: 'birthday',
      emoji: '🎂',
      title: "Ada's Birthday",
      dateStr: 'June 21',
      days: 18,
      gradient: 'linear-gradient(135deg, #f43f5e 0%, #fb7185 50%, #f472b6 100%)',
      textColor: '#ffffff',
      tag: 'Celebration',
      location: 'Home',
    },
    {
      id: 'vacation',
      emoji: '🏖️',
      title: 'Summer Vacation',
      dateStr: 'July 15',
      days: 76,
      gradient: 'linear-gradient(135deg, #0ea5e9 0%, #06b6d4 50%, #14b8a6 100%)',
      textColor: '#ffffff',
      tag: 'Travel',
      location: 'Mediterranean',
    },
    {
      id: 'anniversary',
      emoji: '💍',
      title: 'Anniversary Trip',
      dateStr: 'September 24',
      days: 142,
      gradient: 'linear-gradient(135deg, #8b5cf6 0%, #a855f7 50%, #ec4899 100%)',
      textColor: '#ffffff',
      tag: 'Special Day',
      location: 'Rome, Italy',
    },
    {
      id: 'marathon',
      emoji: '🏃',
      title: 'Marathon 42K',
      dateStr: 'November 8',
      days: 210,
      gradient: 'linear-gradient(135deg, #f97316 0%, #ea580c 50%, #dc2626 100%)',
      textColor: '#ffffff',
      tag: 'Goal',
      location: 'City Marathon',
    },
  ],
};

const presets = PRESETS[locale as keyof typeof PRESETS] ?? PRESETS.default;
const initial = presets[0];
const dayLabel = locale === 'tr' ? 'gün kaldı' : 'days left';
const otherLabel = locale === 'tr' ? 'Diğer tarihler' : 'Upcoming events';
---

<div class="interactive-preview-wrapper relative mx-auto w-full max-w-[380px] select-none">
  <!-- Glowing ambient blur behind device -->
  <div
    class="pointer-events-none absolute -inset-6 -z-10 rounded-[50px] opacity-40 blur-3xl transition-all duration-700"
    id="preview-ambient-glow"
    style={`background: ${initial.gradient};`}
  ></div>

  <!-- Device frame -->
  <div class="relative overflow-hidden rounded-[44px] border-[5px] border-[#27272a] bg-[#09090b] p-3 shadow-2xl shadow-black/80 ring-1 ring-white/15">
    <!-- Dynamic Island / Top speaker pill -->
    <div class="relative z-20 mx-auto mb-2 flex h-5 w-28 items-center justify-center rounded-full bg-[#18181b] shadow-inner">
      <div class="h-2.5 w-2.5 rounded-full bg-[#09090b]/80"></div>
    </div>

    <!-- Screen Content -->
    <div class="space-y-3 px-1 py-1">
      <!-- Status & App header -->
      <div class="flex items-center justify-between px-2 pt-1 text-xs text-white/50">
        <span class="font-medium tracking-tight">Anımsat</span>
        <span class="inline-flex items-center gap-1.5 text-[10px] text-emerald-400 font-mono">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          CANLI
        </span>
      </div>

      <!-- Main Interactive Countdown Card -->
      <div
        id="preview-main-card"
        class="relative min-h-[220px] overflow-hidden rounded-[26px] p-5 shadow-lg transition-all duration-500 flex flex-col justify-between"
        style={`background: ${initial.gradient}; color: ${initial.textColor};`}
      >
        <!-- Card Top Bar -->
        <div class="flex items-center justify-between">
          <span
            id="preview-card-tag"
            class="rounded-full bg-black/25 px-2.5 py-1 text-[11px] font-semibold backdrop-blur-md"
          >
            {initial.emoji} {initial.tag}
          </span>
          <span id="preview-card-location" class="text-[11px] opacity-85 font-medium flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span id="preview-location-text">{initial.location}</span>
          </span>
        </div>

        <!-- Center: Big Countdown Number -->
        <div class="my-auto py-2 text-center">
          <div class="font-serif text-[4.25rem] font-bold leading-none tracking-tight drop-shadow-sm" id="preview-card-days">
            {initial.days}
          </div>
          <div class="mt-1 text-xs font-semibold tracking-wider uppercase opacity-90" id="preview-day-label">
            {dayLabel}
          </div>
        </div>

        <!-- Card Bottom: Title & Target Date -->
        <div class="mt-auto border-t border-white/20 pt-2.5 flex items-end justify-between">
          <div>
            <h4 class="font-serif text-lg font-semibold leading-tight drop-shadow-sm" id="preview-card-title">
              {initial.title}
            </h4>
            <p class="text-xs opacity-80 mt-0.5" id="preview-card-date">
              {initial.dateStr}
            </p>
          </div>
          <!-- Live Time Ticker -->
          <div class="text-right font-mono text-[11px] opacity-90 tabular-nums">
            <span id="preview-live-ticker">08:42:19</span>
          </div>
        </div>
      </div>

      <!-- Secondary Cards in App List -->
      <div class="pt-1">
        <div class="mb-2 px-1 text-[11px] font-semibold tracking-wider text-white/40 uppercase">
          {otherLabel}
        </div>
        <div class="space-y-2">
          {presets.slice(1, 3).map((item) => (
            <div
              class="flex items-center justify-between rounded-2xl border border-white/5 bg-[#18181b]/80 px-3.5 py-2.5 backdrop-blur-sm transition hover:border-white/10"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-base">{item.emoji}</span>
                <div>
                  <div class="text-xs font-semibold text-white/90">{item.title}</div>
                  <div class="text-[10px] text-white/50">{item.dateStr} • {item.location}</div>
                </div>
              </div>
              <div class="text-right">
                <span class="font-serif text-lg font-bold text-white/90">{item.days}</span>
                <span class="block text-[9px] text-white/40 uppercase -mt-1">{dayLabel}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Home indicator line -->
    <div class="mx-auto mt-2 h-1 w-24 rounded-full bg-white/20"></div>
  </div>

  <!-- Interactive Preset Selector Pill Tabs Below Phone -->
  <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5" id="preview-preset-controls">
    {presets.map((preset, index) => (
      <button
        type="button"
        class={`preset-pill-btn inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium transition-all ${
          index === 0
            ? 'active-pill bg-white text-zinc-950 font-semibold shadow-md shadow-white/10 scale-105'
            : 'bg-zinc-900/90 text-zinc-400 hover:bg-zinc-800 hover:text-white border border-white/5'
        }`}
        data-preset={JSON.stringify(preset)}
      >
        <span>{preset.emoji}</span>
        <span>{preset.title.split(' ')[0]}</span>
      </button>
    ))}
  </div>
</div>

<script>
  function initInteractivePreview() {
    const mainCard = document.getElementById('preview-main-card');
    const ambientGlow = document.getElementById('preview-ambient-glow');
    const cardDays = document.getElementById('preview-card-days');
    const cardTitle = document.getElementById('preview-card-title');
    const cardDate = document.getElementById('preview-card-date');
    const cardTag = document.getElementById('preview-card-tag');
    const locationText = document.getElementById('preview-location-text');
    const liveTicker = document.getElementById('preview-live-ticker');
    const buttons = document.querySelectorAll('.preset-pill-btn');

    if (!mainCard) return;

    // Live Clock Ticker
    function updateTicker() {
      const now = new Date();
      const hours = String(23 - now.getHours()).padStart(2, '0');
      const mins = String(59 - now.getMinutes()).padStart(2, '0');
      const secs = String(59 - now.getSeconds()).padStart(2, '0');
      if (liveTicker) {
        liveTicker.textContent = `${hours}:${mins}:${secs}`;
      }
    }
    updateTicker();
    setInterval(updateTicker, 1000);

    // Preset Switching
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-preset');
        if (!raw) return;
        const data = JSON.parse(raw);

        // Update active class on buttons
        buttons.forEach((b) => {
          b.classList.remove('active-pill', 'bg-white', 'text-zinc-950', 'font-semibold', 'scale-105', 'shadow-md', 'shadow-white/10');
          b.classList.add('bg-zinc-900/90', 'text-zinc-400');
        });
        btn.classList.remove('bg-zinc-900/90', 'text-zinc-400');
        btn.classList.add('active-pill', 'bg-white', 'text-zinc-950', 'font-semibold', 'scale-105', 'shadow-md', 'shadow-white/10');

        // Apply smooth transition to card
        mainCard.style.opacity = '0.7';
        mainCard.style.transform = 'scale(0.98)';

        setTimeout(() => {
          mainCard.style.background = data.gradient;
          if (ambientGlow) ambientGlow.style.background = data.gradient;
          if (cardDays) cardDays.textContent = String(data.days);
          if (cardTitle) cardTitle.textContent = data.title;
          if (cardDate) cardDate.textContent = data.dateStr;
          if (cardTag) cardTag.textContent = `${data.emoji} ${data.tag}`;
          if (locationText) locationText.textContent = data.location;

          mainCard.style.opacity = '1';
          mainCard.style.transform = 'scale(1)';
        }, 150);
      });
    });
  }

  // Initialize on load and on Astro page transitions
  initInteractivePreview();
  document.addEventListener('astro:page-load', initInteractivePreview);
</script>

<style>
  #preview-main-card {
    transition: background 0.5s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }
</style>
