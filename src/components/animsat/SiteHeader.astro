---
import { Image } from 'astro:assets';
import { ANIMSAT_NAME, getLanding, landingPath, type AnimsatLocale, type AnimsatPage } from '../../data/animsat';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logo from '../../assets/animsat/logo.png';

interface Props {
  locale?: AnimsatLocale;
  page?: AnimsatPage;
}

const { locale = 'tr', page = 'home' } = Astro.props;
const copy = getLanding(locale);
const homeHref = landingPath(locale);
---

<header class="sticky top-0 z-30 border-b border-white/10 bg-[#050506]/55 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href={homeHref} class="flex items-center gap-2.5 text-[#faf8f5]" aria-label={copy.homeAria}>
      <Image src={logo} alt="" width={72} height={72} densities={[1, 2]} format="png" loading="eager" class="h-9 w-9" />
      <span class="animsat-display text-lg tracking-tight">{ANIMSAT_NAME}</span>
    </a>
    <LanguageSwitcher current={locale} page={page} />
  </div>
</header>
