---
import { Image } from 'astro:assets';
import {
  ANIMSAT_NAME,
  ANIMSAT_GITHUB_URL,
  getAppStoreUrl,
  getLanding,
  landingPath,
  type AnimsatLocale,
  type AnimsatPage,
} from '../../data/animsat';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logo from '../../assets/animsat/logo.png';

interface Props {
  locale?: AnimsatLocale;
  page?: AnimsatPage;
}

const { locale = 'tr', page = 'home' } = Astro.props;
const copy = getLanding(locale);
const homeHref = landingPath(locale);
const appStoreUrl = getAppStoreUrl(locale);

const navPrefix = page === 'home' ? '' : homeHref;
const featuresHref = `${navPrefix}#ozellikler`;
const widgetHref = `${navPrefix}#widgetlar`;
const privacyHref = `${navPrefix}#gizlilik`;
const freeHref = `${navPrefix}#ucretsiz`;
---

<header class="sticky top-0 z-40 w-full px-4 pt-4 sm:px-6 sm:pt-5">
  <nav class="animsat-header-nav mx-auto flex max-w-5xl items-center justify-between gap-4 rounded-full border border-white/[0.1] bg-[#09090c]/70 px-4 py-2.5 shadow-[0_8px_32px_rgba(0,0,0,0.65)] backdrop-blur-2xl sm:px-5">
    <!-- Brand -->
    <a href={homeHref} class="group flex items-center gap-2.5 text-[#faf8f5] transition-opacity hover:opacity-90" aria-label={copy.homeAria}>
      <div class="relative flex h-8 w-8 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-white/10 to-white/5 p-1 shadow-inner ring-1 ring-white/15">
        <Image src={logo} alt="" width={64} height={64} densities={[1, 2]} format="png" loading="eager" class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105" />
      </div>
      <span class="animsat-display text-base font-semibold tracking-tight text-white">{ANIMSAT_NAME}</span>
    </a>

    <!-- Quick Navigation (Desktop) -->
    <div class="hidden items-center gap-1 md:flex" role="navigation" aria-label="Sayfa içi gezinme">
      <a href={featuresHref} class="animsat-nav-link">{copy.featuresKicker}</a>
      <a href={widgetHref} class="animsat-nav-link">Widget</a>
      <a href={privacyHref} class="animsat-nav-link">{copy.privacyKicker}</a>
      <a href={freeHref} class="animsat-nav-link">{copy.proKicker}</a>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <LanguageSwitcher current={locale} page={page} />
      <a
        href={ANIMSAT_GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/5 text-stone-300 transition hover:border-white/25 hover:bg-white/10 hover:text-white"
        aria-label="GitHub Repository"
        title="GitHub"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
      {
        appStoreUrl ? (
          <a
            href={appStoreUrl}
            class="animsat-nav-cta hidden sm:inline-flex"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>App Store</span>
          </a>
        ) : (
          <a
            href="#ozellikler"
            class="animsat-nav-cta hidden sm:inline-flex"
          >
            <span>{copy.ctaSoon}</span>
          </a>
        )
      }
    </div>
  </nav>
</header>
