---
import { Image } from 'astro:assets';
import { ANIMSAT_NAME, ANIMSAT_PATH, policyPath } from '../../data/animsat';
import logo from '../../assets/animsat/logo.png';

const privacyHref = policyPath('tr');
---

<header class="sticky top-0 z-30 border-b border-white/10 bg-[#050506]/55 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href={ANIMSAT_PATH} class="flex items-center gap-2.5 text-[#faf8f5]" aria-label={`${ANIMSAT_NAME} ana sayfa`}>
      <Image src={logo} alt="" width={72} height={72} densities={[1, 2]} format="png" loading="eager" class="h-9 w-9" />
      <span class="animsat-display text-lg tracking-tight">{ANIMSAT_NAME}</span>
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium text-[#faf8f5]/70" aria-label="Anımsat">
      <a href={`${ANIMSAT_PATH}#ozellikler`} class="transition hover:text-[#faf8f5]">Özellikler</a>
      <a href={privacyHref} class="transition hover:text-[#faf8f5]">Gizlilik</a>
    </nav>
  </div>
</header>
