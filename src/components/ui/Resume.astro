---
import { work } from '../../data/about';
import BriefcaseIcon from './icons/BriefcaseIcon.astro';
---

<div class="rounded-2xl border border-zinc-200/70 p-6 dark:border-zinc-700/40">
  <h2 class="flex text-sm font-semibold text-zinc-900 dark:text-zinc-100">
    <BriefcaseIcon class="h-6 w-6 flex-none" />
    <span class="ml-3">İş Deneyimi</span>
  </h2>
  <ol class="mt-6 space-y-4">
    {
      work.map((role) => (
        <li class="flex flex-wrap gap-x-2">
          <dl class="flex w-full flex-wrap gap-x-2">
            <dt class="sr-only">Şirket</dt>
            <dd class="flex-none text-sm font-medium text-zinc-900 dark:text-zinc-100">{role.company}</dd>
            <dt class="sr-only">Tarih</dt>
            <dd class="ml-auto text-xs text-zinc-500 dark:text-zinc-400" aria-label={`${role.start} - ${role.end}`}>
              <time>{role.start}</time> <span aria-hidden="true">—</span> <time>{role.end}</time>
            </dd>
            <dt class="sr-only">Pozisyon</dt>
            <dd class="w-full text-xs text-zinc-500 dark:text-zinc-400">{role.title}</dd>
          </dl>
        </li>
      ))
    }
  </ol>
</div>
