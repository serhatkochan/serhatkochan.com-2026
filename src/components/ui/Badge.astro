---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

{
  href ? (
    <a href={href} class:list={['inline-flex items-center rounded-md bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary dark:bg-primary/20 dark:text-primary-light', className]}>
      <slot />
    </a>
  ) : (
    <span class:list={['inline-flex items-center rounded-md bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary dark:bg-primary/20 dark:text-primary-light', className]}>
      <slot />
    </span>
  )
}
