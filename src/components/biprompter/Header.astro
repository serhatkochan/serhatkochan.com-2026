---
import { BIPROMPTER_DOWNLOAD_URL, BIPROMPTER_NAME, BIPROMPTER_VERSION } from '../../data/biprompter/meta';
---

<header class="sticky top-4 z-50 px-4 sm:px-6 max-w-6xl mx-auto w-full">
  <div class="flex items-center justify-between gap-4 px-4 py-3 rounded-2xl bg-zinc-950/80 border border-zinc-800/80 backdrop-blur-xl shadow-xl shadow-black/40">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <img
        src="/biprompter/logo.png"
        alt={BIPROMPTER_NAME}
        width="34"
        height="34"
        class="rounded-xl shadow-sm border border-zinc-700/50 group-hover:scale-105 transition-transform"
      />
      <div class="flex items-center gap-2">
        <span class="font-bold text-base sm:text-lg tracking-tight text-white group-hover:text-sky-400 transition-colors">
          {BIPROMPTER_NAME}
        </span>
        <span class="hidden sm:inline-block px-2 py-0.5 text-[10px] font-mono font-medium rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20">
          v{BIPROMPTER_VERSION}
        </span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-zinc-400">
      <a href="#simulator" class="hover:text-zinc-100 transition-colors">Canlı Vitrin</a>
      <a href="#features" class="hover:text-zinc-100 transition-colors">Özellikler</a>
      <a href="#benchmark" class="hover:text-zinc-100 transition-colors">Mimari & RAM</a>
      <a href="#shortcuts" class="hover:text-zinc-100 transition-colors">Kısayollar</a>
      <a href="#gallery" class="hover:text-zinc-100 transition-colors">Galeri</a>
      <a href="#install" class="hover:text-zinc-100 transition-colors">Kurulum</a>
    </nav>

    <!-- GitHub & Portfolio Action Buttons -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="https://www.serhatkochan.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900 border border-transparent hover:border-zinc-800 transition"
      >
        <span>← serhatkochan.com</span>
      </a>

      <a
        href={BIPROMPTER_DOWNLOAD_URL}
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700/80 hover:border-sky-500/50 text-white text-xs font-semibold shadow-sm transition group"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" /></svg>
        <span>İndir (.exe)</span>
      </a>
    </div>
  </div>
</header>
