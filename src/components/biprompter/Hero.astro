---
import InteractiveIslandSimulator from './InteractiveIslandSimulator';
import { BIPROMPTER_DOWNLOAD_URL, BIPROMPTER_VERSION } from '../../data/biprompter/meta';
---

<section class="relative pt-12 pb-16 sm:pt-20 sm:pb-24 px-4 sm:px-6 max-w-6xl mx-auto w-full flex flex-col items-center text-center">
  <!-- Glowing Announcement Badge -->
  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-900/90 border border-zinc-700/80 shadow-inner mb-8">
    <span class="flex h-2 w-2 rounded-full bg-sky-400 animate-pulse"></span>
    <span class="text-xs font-medium text-zinc-300">
      Windows için Mac Dynamic Island Deneyimi
    </span>
    <span class="text-zinc-600">•</span>
    <span class="text-xs font-mono text-sky-400">
      %100 Yerel Vosk AI
    </span>
  </div>

  <!-- Primary Headline -->
  <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-4xl leading-[1.15]">
    Ekranı kaplamayan, <span class="bg-gradient-to-r from-sky-400 via-cyan-300 to-indigo-400 bg-clip-text text-transparent">sesinizi dinleyip</span> siz konuştukça ilerleyen prompter.
  </h1>

  <!-- Anti-Slop Authentic Description -->
  <p class="mt-6 text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed">
    Kamera karşısında konuşurken koca bir pencereyle ekranı bloke etmeye son. Biprompter ekranın en tepesinde zarif bir ada gibi yüzer; harici hiçbir sunucuya veri göndermeden sesinizi cihazda dinler ve OBS / Zoom yayınlarında izleyicilere görünmez kalır.
  </p>

  <!-- CTA Buttons -->
  <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
    <a
      href={BIPROMPTER_DOWNLOAD_URL}
      class="inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-zinc-950 font-semibold text-sm transition-all shadow-lg shadow-sky-500/20 hover:scale-[1.02] active:scale-[0.98]"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" /></svg>
      <span>Windows için indir (.exe)</span>
    </a>

    <a
      href="#install"
      class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700/80 text-zinc-200 text-sm font-medium transition hover:border-zinc-500"
    >
      <span>Kurulum adımları</span>
    </a>
  </div>

  <p class="mt-3 text-xs text-zinc-400">v{BIPROMPTER_VERSION} · Windows 10 / 11 · 64 bit (x64) · Ücretsiz</p>

  <!-- Micro Specs Line -->
  <div class="mt-6 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-zinc-500 font-mono">
    <span class="inline-flex items-center gap-1.5">
      <span class="text-emerald-400">✓</span> ~35-45 MB RAM (Rust & Tauri v2)
    </span>
    <span class="inline-flex items-center gap-1.5">
      <span class="text-emerald-400">✓</span> %100 Çevrimdışı WebAssembly
    </span>
    <span class="inline-flex items-center gap-1.5">
      <span class="text-emerald-400">✓</span> OBS / Ekran Paylaşımından Gizleme
    </span>
  </div>

  <!-- Interactive Simulator Anchor & Display -->
  <div id="simulator" class="w-full mt-14 sm:mt-16 scroll-mt-24">
    <InteractiveIslandSimulator client:load />
  </div>
</section>
