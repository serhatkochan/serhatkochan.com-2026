---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import NoteShare from '../../components/notes/NoteShare.astro';
import { site } from '../../data/site';
import { formatDate } from '../../lib/dates';
import { blogPostingSchema, breadcrumbSchema } from '../../lib/seo';
import MdxImage from '../../components/mdx/MdxImage.astro';
import { noteImages } from '../../data/photos';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const noteUrl = `${site.url}/notes/${note.id}`;

const noteImageEntry = Object.entries(noteImages).find(([path]) => path.includes(`/notes/${note.id}/`));
const notePreloadImage = noteImageEntry
  ? (await getImage({ src: noteImageEntry[1], width: 800, format: 'webp' })).src
  : undefined;
---

<BaseLayout
  title={note.data.title}
  description={note.data.description}
  path={`/notes/${note.id}`}
  type="article"
  publishedTime={note.data.publishedAt}
  modifiedTime={note.data.updatedAt ?? note.data.publishedAt}
  preloadImage={notePreloadImage}
  schema={[
    blogPostingSchema({
      title: note.data.title,
      description: note.data.description,
      slug: note.id,
      publishedAt: note.data.publishedAt,
      updatedAt: note.data.updatedAt,
    }),
    breadcrumbSchema([
      { name: 'Anasayfa', path: '/' },
      { name: 'Notlar', path: '/notes' },
      { name: note.data.title, path: `/notes/${note.id}` },
    ]),
  ]}
>
  <Container class="mt-16 sm:mt-32">
    <article class="max-w-2xl lg:max-w-5xl">
      <header class="flex flex-col">
        <time datetime={note.data.publishedAt.toISOString()} class="order-first flex flex-wrap items-center gap-3 text-base text-zinc-400 dark:text-zinc-500">
          <span class="flex items-center">
            <span class="h-4 w-0.5 rounded-full bg-zinc-200 dark:bg-zinc-500" aria-hidden="true"></span>
            <span class="ml-3">{formatDate(note.data.publishedAt)}</span>
          </span>
          {
            note.data.inProgress && (
              <span class="inline-flex items-center rounded-md bg-primary px-2.5 py-1 text-xs font-medium leading-normal text-white">
                Devam ediyor
              </span>
            )
          }
        </time>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 sm:text-5xl">{note.data.title}</h1>
        <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-300">{note.data.description}</p>
      </header>

      {
        note.data.inProgress ? (
          <div class="mt-12 rounded-xl border border-zinc-200 bg-zinc-50 px-5 py-4 dark:border-zinc-800 dark:bg-zinc-900/50">
            <p class="text-base leading-7 text-zinc-600 dark:text-zinc-300">
              Bu yazı üzerinde hâlâ çalışıyorum. Tamamlandığında burada yayınlanacak.
            </p>
          </div>
        ) : (
          <div class="prose-note mt-12 max-w-3xl">
            <Content components={{ img: MdxImage }} />
          </div>
        )
      }

      <footer class="mt-16 flex flex-col gap-8 border-t border-zinc-200 pt-8 dark:border-zinc-800">
        <NoteShare url={noteUrl} />
        <a href="/notes" class="text-sm font-medium text-primary hover:underline">← Tüm notlara dön</a>
      </footer>
    </article>
  </Container>
</BaseLayout>
