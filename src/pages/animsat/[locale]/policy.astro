---
import AnimsatLayout from '../../../layouts/AnimsatLayout.astro';
import SiteHeader from '../../../components/animsat/SiteHeader.astro';
import SiteFooter from '../../../components/animsat/SiteFooter.astro';
import {
  ANIMSAT_NAME,
  ANIMSAT_POLICY_LOCALES,
  getAnimsatLocale,
  getLanding,
  getPrivacyDoc,
  isAnimsatLocale,
  landingPath,
  policyCanonical,
  policyPath,
} from '../../../data/animsat';
import { privacyPolicySchema, softwareApplicationSchema } from '../../../lib/seo';

export function getStaticPaths() {
  return ANIMSAT_POLICY_LOCALES.map((item) => ({
    params: { locale: item.id },
  }));
}

const localeParam = Astro.params.locale;
if (!isAnimsatLocale(localeParam)) {
  throw new Error(`Unknown Anımsat locale: ${localeParam}`);
}

const locale = localeParam;
const localeDef = getAnimsatLocale(locale);
const doc = getPrivacyDoc(locale);
const copy = getLanding(locale);
const path = policyPath(locale);
const canonical = policyCanonical(locale);
const description = doc.intro;
const alternates = [
  ...ANIMSAT_POLICY_LOCALES.map((item) => ({
    hreflang: item.hreflang,
    href: policyCanonical(item.id),
  })),
  { hreflang: 'x-default', href: policyCanonical('tr') },
];
---

<AnimsatLayout
  title={`${doc.title} — ${ANIMSAT_NAME}`}
  description={description}
  path={path}
  canonical={canonical}
  htmlLang={localeDef.htmlLang}
  ogLocale={localeDef.ogLocale}
  dir={localeDef.rtl ? 'rtl' : 'ltr'}
  skipLabel={copy.skipToContent}
  alternates={alternates}
  keywords={['animsat', 'gizlilik-politikasi', 'privacy-policy', locale]}
  schema={[
    softwareApplicationSchema(),
    privacyPolicySchema({
      title: `${doc.title} — ${ANIMSAT_NAME}`,
      description,
      path: canonical,
      locale: localeDef.htmlLang,
    }),
  ]}
>
  <SiteHeader slot="header" locale={locale} page="policy" />

  <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">
      <a href={landingPath(locale)} class="hover:text-[#faf8f5]">{ANIMSAT_NAME}</a>
      <span aria-hidden="true" class="mx-2 text-[#faf8f5]/30">/</span>
      <span class="text-[#faf8f5]/55">{doc.title}</span>
    </p>

    <article class="mt-12" lang={localeDef.htmlLang} dir={localeDef.rtl ? 'rtl' : 'ltr'}>
      <header>
        <h1 class="animsat-display text-4xl text-[#faf8f5] sm:text-5xl">{doc.title}</h1>
        <p class="mt-3 text-sm text-[#a8a29e]">{doc.updated}</p>
      </header>

      <p class="mt-8 text-base leading-7 text-[#faf8f5]/80">{doc.intro}</p>

      {
        doc.sections.map((section) => (
          <section class="mt-10">
            <h2 class="animsat-display text-xl text-[#faf8f5]">{section.title}</h2>
            {section.body.split(/\n\n+/).map((paragraph) => (
              <p class="mt-3 whitespace-pre-line text-base leading-7 text-[#a8a29e]">{paragraph}</p>
            ))}
            {section.linkUrl && section.linkLabel && (
              <p class="mt-3">
                <a
                  href={section.linkUrl}
                  class="text-sm font-medium text-[#c45c4a] transition hover:text-[#faf8f5]"
                  target={section.linkUrl.startsWith('mailto:') ? undefined : '_blank'}
                  rel={section.linkUrl.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                >
                  {section.linkLabel}
                </a>
              </p>
            )}
          </section>
        ))
      }
    </article>
  </div>

  <SiteFooter slot="footer" locale={locale} />
</AnimsatLayout>
