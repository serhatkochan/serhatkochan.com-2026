---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/layout/Container.astro';
import PolicyLanguageNav from '../../../components/animsat/PolicyLanguageNav.astro';
import {
  ANIMSAT_NAME,
  ANIMSAT_PATH,
  ANIMSAT_POLICY_LOCALES,
  animsatCanonical,
  getAnimsatLocale,
  getPrivacyDoc,
  isAnimsatLocale,
  policyCanonical,
  policyPath,
} from '../../../data/animsat';
import { breadcrumbSchema, buildCanonical, privacyPolicySchema, softwareApplicationSchema } from '../../../lib/seo';

export function getStaticPaths() {
  return ANIMSAT_POLICY_LOCALES.map((item) => ({
    params: { locale: item.id },
  }));
}

const localeParam = Astro.params.locale;
if (!isAnimsatLocale(localeParam)) {
  throw new Error(`Unknown Anımsat locale: ${localeParam}`);
}

const locale = localeParam;
const localeDef = getAnimsatLocale(locale);
const doc = getPrivacyDoc(locale);
const path = policyPath(locale);
const canonical = policyCanonical(locale);
const homeCanonical = animsatCanonical('/');
const description = doc.intro;
const alternates = [
  ...ANIMSAT_POLICY_LOCALES.map((item) => ({
    hreflang: item.hreflang,
    href: policyCanonical(item.id),
  })),
  { hreflang: 'x-default', href: policyCanonical('tr') },
];
---

<BaseLayout
  title={`${doc.title} — ${ANIMSAT_NAME}`}
  description={description}
  path={path}
  canonical={canonical}
  siteName={ANIMSAT_NAME}
  absoluteTitle
  htmlLang={localeDef.htmlLang}
  ogLocale={localeDef.ogLocale}
  alternates={alternates}
  keywords={['animsat', 'gizlilik-politikasi', 'privacy-policy', locale]}
  schema={[
    softwareApplicationSchema(),
    privacyPolicySchema({
      title: `${doc.title} — ${ANIMSAT_NAME}`,
      description,
      path: canonical,
      locale: localeDef.htmlLang,
    }),
    breadcrumbSchema([
      { name: 'Anasayfa', path: '/' },
      { name: 'Projeler', path: '/projects' },
      { name: ANIMSAT_NAME, path: homeCanonical },
      { name: doc.title, path: canonical },
    ]),
  ]}
>
  <Container class="mt-16 sm:mt-32">
    <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">
      <a href={buildCanonical('/projects')} class="transition hover:text-primary">Projeler</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a href={ANIMSAT_PATH} class="transition hover:text-primary">{ANIMSAT_NAME}</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span>{doc.title}</span>
    </p>

    <div class="mt-8">
      <PolicyLanguageNav current={locale} label={localeDef.languageLabel} />
    </div>

    <article class="mt-10 max-w-2xl" lang={localeDef.htmlLang} dir={localeDef.rtl ? 'rtl' : 'ltr'}>
      <header>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100 sm:text-5xl">
          {doc.title}
        </h1>
        <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">{doc.updated}</p>
      </header>

      <p class="mt-8 text-base leading-7 text-zinc-700 dark:text-zinc-300">{doc.intro}</p>

      {
        doc.sections.map((section) => (
          <section class="mt-8">
            <h2 class="text-lg font-semibold tracking-tight text-zinc-800 dark:text-zinc-100">{section.title}</h2>
            {section.body.split(/\n\n+/).map((paragraph) => (
              <p class="mt-3 whitespace-pre-line text-base leading-7 text-zinc-600 dark:text-zinc-300">{paragraph}</p>
            ))}
            {section.linkUrl && section.linkLabel && (
              <p class="mt-3">
                <a
                  href={section.linkUrl}
                  class="text-sm font-medium text-primary transition hover:text-primary-dark dark:hover:text-primary-light"
                  target={section.linkUrl.startsWith('mailto:') ? undefined : '_blank'}
                  rel={section.linkUrl.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                >
                  {section.linkLabel}
                </a>
              </p>
            )}
          </section>
        ))
      }
    </article>
  </Container>
</BaseLayout>
