---
import { Image } from 'astro:assets';
import AnimsatLayout from '../../layouts/AnimsatLayout.astro';
import PhoneFrame from '../../components/animsat/PhoneFrame.astro';
import SiteHeader from '../../components/animsat/SiteHeader.astro';
import SiteFooter from '../../components/animsat/SiteFooter.astro';
import AnimsatCountdown from '../../islands/AnimsatCountdown';
import {
  ANIMSAT_APP_STORE_URL,
  ANIMSAT_DEMO_DATE,
  ANIMSAT_DESCRIPTION,
  ANIMSAT_NAME,
  ANIMSAT_PATH,
  ANIMSAT_PLAY_STORE_URL,
  ANIMSAT_SITE_URL,
  ANIMSAT_TAGLINE,
  animsatCanonical,
  policyPath,
} from '../../data/animsat';
import { landing } from '../../data/animsat/landing';
import { softwareApplicationSchema } from '../../lib/seo';
import shotHome from '../../assets/animsat/onboarding-home.jpg';
import shotPhoto from '../../assets/animsat/onboarding-add-photo.jpg';
import shotColor from '../../assets/animsat/onboarding-add.jpg';
import shotWidget from '../../assets/animsat/onboarding-widget.jpg';

const privacyHref = policyPath('tr');
const homeCanonical = animsatCanonical('/');
const moments = [...landing.moments, ...landing.moments];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: ANIMSAT_NAME,
    alternateName: ANIMSAT_TAGLINE,
    url: ANIMSAT_SITE_URL,
    description: ANIMSAT_DESCRIPTION,
    inLanguage: 'tr',
  },
  softwareApplicationSchema(),
];
---

<AnimsatLayout
  title={`${ANIMSAT_NAME} — ${ANIMSAT_TAGLINE}`}
  description={ANIMSAT_DESCRIPTION}
  path={ANIMSAT_PATH}
  canonical={homeCanonical}
  keywords={['animsat', 'kac-gun-kaldi', 'gerisayim', 'widget', 'hatirlatici']}
  schema={schema}
>
  <SiteHeader slot="header" />

  <section class="relative mx-auto max-w-6xl px-5 pb-20 pt-16 sm:px-8 sm:pt-24 lg:pb-28">
    <p class="animsat-reveal text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">
      {landing.eyebrow} · {ANIMSAT_TAGLINE}
    </p>
    <div class="mt-8 grid items-end gap-12 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="animsat-reveal animsat-reveal-2 text-[0.7rem] font-semibold tracking-[0.22em] text-[#faf8f5]/45 uppercase">
          {landing.demoCaption}
        </p>
        <p class="animsat-count animsat-reveal animsat-reveal-2 mt-2">
          <AnimsatCountdown client:idle targetIso={ANIMSAT_DEMO_DATE} />
        </p>
        <h1 class="animsat-display animsat-reveal animsat-reveal-3 mt-6 max-w-xl text-4xl leading-[1.05] text-[#faf8f5] sm:text-6xl">
          {landing.headline}
        </h1>
        <p class="animsat-reveal animsat-reveal-4 mt-5 max-w-md text-base leading-7 text-[#a8a29e] sm:text-lg">
          {landing.lede}
        </p>
        <div class="animsat-reveal animsat-reveal-4 mt-10 flex flex-wrap items-center gap-3">
          {
            ANIMSAT_APP_STORE_URL ? (
              <a
                href={ANIMSAT_APP_STORE_URL}
                class="rounded-full bg-[#faf8f5] px-5 py-2.5 text-sm font-semibold text-[#121212] transition hover:bg-white"
              >
                App Store
              </a>
            ) : (
              <span class="rounded-full bg-[#faf8f5] px-5 py-2.5 text-sm font-semibold text-[#121212]">
                {landing.ctaSoon}
              </span>
            )
          }
          {
            ANIMSAT_PLAY_STORE_URL ? (
              <a
                href={ANIMSAT_PLAY_STORE_URL}
                class="rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-[#faf8f5] transition hover:border-white/50"
              >
                Google Play
              </a>
            ) : null
          }
          <a href={privacyHref} class="px-3 text-sm text-[#faf8f5]/60 underline-offset-4 hover:text-[#faf8f5] hover:underline">
            {landing.ctaPrivacy}
          </a>
        </div>
      </div>

      <div class="animsat-reveal animsat-reveal-3 relative mx-auto flex w-full max-w-md justify-center lg:mx-0 lg:justify-end">
        <PhoneFrame
          src={shotHome}
          alt="Anımsat ana ekranı: fotoğraflı tarih kartları ve kaç gün kaldığı"
          class="relative z-10 rotate-[-7deg]"
          priority
        />
        <PhoneFrame
          src={shotWidget}
          alt="Anımsat widget’ları iPhone ana ekranında"
          class="absolute top-16 right-0 hidden w-[210px] rotate-[9deg] sm:block"
        />
      </div>
    </div>
  </section>

  <div class="animsat-marquee" aria-hidden="true">
    <div class="animsat-marquee-track">
      {moments.map((item) => <span>{item}</span>)}
    </div>
  </div>

  <section id="ozellikler" class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <p class="text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">Nasıl durur yanında</p>
    <h2 class="animsat-display mt-4 max-w-xl text-3xl text-[#faf8f5] sm:text-5xl">
      Tarihi kaydet. Kalanı her gün gör.
    </h2>

    <div class="mt-16 grid gap-16 lg:gap-24">
      <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="font-mono text-xs tracking-[0.2em] text-[#faf8f5]/40">{landing.features[0].kicker}</p>
          <h3 class="animsat-display mt-3 text-3xl text-[#faf8f5]">{landing.features[0].title}</h3>
          <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{landing.features[0].body}</p>
        </div>
        <PhoneFrame src={shotHome} alt="Önemli günlerin listelendiği Anımsat ana ekranı" class="mx-auto" />
      </article>

      <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <PhoneFrame
          src={shotPhoto}
          alt="Fotoğraflı doğum günü kartı düzenleme ekranı"
          class="mx-auto lg:order-2"
        />
        <div class="lg:order-1">
          <p class="font-mono text-xs tracking-[0.2em] text-[#faf8f5]/40">{landing.features[1].kicker}</p>
          <h3 class="animsat-display mt-3 text-3xl text-[#faf8f5]">{landing.features[1].title}</h3>
          <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{landing.features[1].body}</p>
        </div>
      </article>

      <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="font-mono text-xs tracking-[0.2em] text-[#faf8f5]/40">{landing.features[2].kicker}</p>
          <h3 class="animsat-display mt-3 text-3xl text-[#faf8f5]">{landing.features[2].title}</h3>
          <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{landing.features[2].body}</p>
        </div>
        <PhoneFrame src={shotColor} alt="Renk gradyanlı Anımsat kart önizlemesi" class="mx-auto" />
      </article>

      <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="overflow-hidden rounded-[2rem] border border-white/10 shadow-[0_40px_80px_-24px_rgba(0,0,0,0.85)] lg:order-2">
          <Image
            src={shotWidget}
            alt="Anımsat widget’ları kilit ve ana ekranda"
            widths={[480, 720, 1080]}
            sizes="(min-width: 1024px) 540px, 100vw"
            format="webp"
            quality={78}
            class="h-auto w-full"
          />
        </div>
        <div class="lg:order-1">
          <p class="font-mono text-xs tracking-[0.2em] text-[#faf8f5]/40">{landing.features[3].kicker}</p>
          <h3 class="animsat-display mt-3 text-3xl text-[#faf8f5]">{landing.features[3].title}</h3>
          <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{landing.features[3].body}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="border-y border-white/10 bg-black/35">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">Gizlilik</p>
        <h2 class="animsat-display mt-4 text-3xl text-[#faf8f5] sm:text-4xl">{landing.privacyTitle}</h2>
        <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{landing.privacyBody}</p>
        <a href={privacyHref} class="mt-6 inline-block text-sm font-medium text-[#faf8f5] underline-offset-4 hover:underline">
          {landing.ctaPrivacy}
        </a>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-[0.28em] text-[#c45c4a] uppercase">Pro</p>
        <h2 class="animsat-display mt-4 text-3xl text-[#faf8f5] sm:text-4xl">{landing.proTitle}</h2>
        <p class="mt-4 max-w-md text-base leading-7 text-[#a8a29e]">{landing.proBody}</p>
        <ul class="mt-6 grid gap-2 text-sm text-[#faf8f5]/80 sm:grid-cols-2">
          {landing.proItems.map((item) => (
            <li class="border-b border-white/10 py-2">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</AnimsatLayout>
