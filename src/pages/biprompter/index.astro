---
import BiprompterLayout from '../../layouts/BiprompterLayout.astro';
import Header from '../../components/biprompter/Header.astro';
import Hero from '../../components/biprompter/Hero.astro';
import FeatureBento from '../../components/biprompter/FeatureBento.astro';
import ArchitectureBenchmark from '../../components/biprompter/ArchitectureBenchmark.astro';
import ShortcutsMatrix from '../../components/biprompter/ShortcutsMatrix.astro';
import ScreenshotsGallery from '../../components/biprompter/ScreenshotsGallery.astro';
import QuickStart from '../../components/biprompter/QuickStart.astro';
import Footer from '../../components/biprompter/Footer.astro';
---

<BiprompterLayout>
  <Header />
  <main class="flex-1 flex flex-col items-center w-full">
    <Hero />
